#!name=xloc 定位伪装
#!desc=Cloudflare Worker + Shadowrocket iOS 定位修改模块
#!author=dev-droid

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

[Script]
xloc_spoofer = type=http-response,pattern=^https?:\/\/(?:gs-loc(?:-cn)?\.apple\.com|gsp-ssl\.ls\.apple\.com|bluedot\.is\.autonavi\.com(?:\.gds\.alibabadns\.com)?)\/clls\/wloc(?:\?.*)?$,requires-body=1,binary-body-mode=1,max-size=1048576,timeout=10,script-path=https://raw.githubusercontent.com/dev-droid/xloc/main/location.js,argument=configUrl=https://xloc.999786.xyz/loc.json?token=你的TOKEN
