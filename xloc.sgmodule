#!name=xloc 定位伪装模块
#!desc=基于 Cloudflare Worker 的 iOS 定位修改模块。导入后，请点击模块进入编辑，在 argument= 后面换成你自己的 CF Worker 链接和 Token。
#!author=dev-droid

[MITM]
hostname = %APPEND% gs-loc.apple.com, gs-loc-cn.apple.com, gsp-ssl.ls.apple.com, bluedot.is.autonavi.com, bluedot.is.autonavi.com.gds.alibabadns.com

[Script]
# 拦截苹果定位请求，交由 JS 脚本处理并向 Worker 请求最新坐标
xloc_spoofer = type=http-response,pattern=^https?:\/\/(gs-loc(-cn)?|gsp-ssl\.ls)\.apple\.com\/clls\/wloc,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/mekos2772/ios-location-spoofer/main/location.js,argument=configUrl=https://你的Worker名字.workers.dev/loc.json?token=你的TOKEN